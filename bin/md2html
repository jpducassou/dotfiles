#!/bin/bash

set -euo pipefail

basedir="$(dirname "${0}")"
input="${1:?Usage: md2html <file.md>}"
output="${input%.*}.html"
title="$(basename ${input%.*})"

pandoc "${input}" \
	--standalone \
	--from gfm \
	--to html \
	--metadata pagetitle="${title}" \
	--output "${output}" \
	--css "${basedir}/github-pandoc.css"

